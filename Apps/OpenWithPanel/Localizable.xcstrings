    "These files will open with the app set for their kind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُفتح هذه الملفات بالتطبيق المعيّن لنوعها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dateien werden mit der App geöffnet, die für ihre Art festgelegt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos archivos se abrirán con la app asignada a su tipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces fichiers s’ouvriront avec l’app définie pour leur type."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये फ़ाइलें अपने प्रकार के लिए सेट किए गए ऐप से खुलेंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File-file ini akan dibuka dengan app yang diatur untuk jenisnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルは、その種類に設定された App で開くようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일들은 해당 종류에 설정된 앱으로 열립니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses arquivos serão abertos com o app definido para o tipo deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти файлы будут открываться приложением, заданным для их вида."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์เหล่านี้จะเปิดด้วยแอปที่ตั้งไว้สำหรับชนิดของไฟล์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp này sẽ mở bằng ứng dụng được đặt cho loại của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
