    "A text report of your settings and this session’s log, for sending to the developer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقرير نصي يتضمن إعداداتك وسجل هذه الجلسة، لإرساله إلى المطوّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Textbericht mit deinen Einstellungen und dem Protokoll dieser Sitzung, zum Senden an den Entwickler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe de texto con tus ajustes y el registro de esta sesión, para enviarlo al desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport texte avec vos réglages et le journal de cette session, à envoyer au développeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सेटिंग्स और इस सत्र के लॉग वाली एक टेक्स्ट रिपोर्ट, डेवलपर को भेजने के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan teks berisi pengaturan Anda dan log sesi ini, untuk dikirim ke pengembang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定とこのセッションのログをまとめたテキストレポート。開発者に送るためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정과 이번 세션의 로그를 담은 텍스트 보고서로, 개발자에게 보낼 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório em texto com seus ajustes e o registro desta sessão, para enviar ao desenvolvedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовый отчёт с вашими настройками и журналом этого сеанса, чтобы отправить разработчику."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานข้อความที่มีการตั้งค่าของคุณและบันทึกของการใช้งานครั้งนี้ สำหรับส่งให้ผู้พัฒนา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo dạng văn bản gồm cài đặt của bạn và nhật ký phiên này, để gửi cho nhà phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一份文本报告，包含你的设置和本次运行的日志，可以发给开发者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一份文字報告，包含你的設定和本次執行的記錄，可以傳給開發者。"
