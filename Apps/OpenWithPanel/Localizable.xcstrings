    "No app is set for it, so OpenWithPanel shows it in Finder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعيَّن له تطبيق، لذلك يعرضه OpenWithPanel في Finder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür ist keine App festgelegt, daher zeigt OpenWithPanel sie im Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene ninguna app asignada, así que OpenWithPanel lo muestra en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune app n’est définie pour lui, OpenWithPanel l’affiche donc dans le Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके लिए कोई ऐप सेट नहीं है, इसलिए OpenWithPanel इसे Finder में दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada app yang diatur untuknya, jadi OpenWithPanel menampilkannya di Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App が設定されていないため、OpenWithPanel は Finder で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정된 앱이 없으므로 OpenWithPanel이 Finder에서 보여 줍니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há app definido para ele, por isso o OpenWithPanel o mostra no Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для него не задано приложение, поэтому OpenWithPanel показывает его в Finder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ตั้งแอปให้ไฟล์นี้ OpenWithPanel จึงแสดงไฟล์ใน Finder"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa đặt ứng dụng cho tệp này nên OpenWithPanel hiển thị nó trong Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有为它设置 App，所以 OpenWithPanel 在访达中显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有為它設定 App，所以 OpenWithPanel 在 Finder 中顯示它。"
          }
        }
      }
    },
    "No conditions, never matches" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا شروط، لا يتطابق أبدًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
