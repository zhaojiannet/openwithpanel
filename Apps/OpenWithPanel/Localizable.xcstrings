    "macOS could not tell what kind of file this is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على macOS معرفة نوع هذا الملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS konnte nicht erkennen, um welche Art Datei es sich handelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha podido saber qué tipo de archivo es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
