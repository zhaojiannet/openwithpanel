    "Add a file extension that isn’t listed, then choose an app for it like any other format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف امتدادًا غير موجود في القائمة، ثم اختر له تطبيقًا كأي تنسيق آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine fehlende Dateiendung hinzu und wähle wie bei jedem anderen Format eine App dafür."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una extensión que no aparece y elige una app para ella como con cualquier otro formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une extension absente de la liste, puis choisissez-lui une app comme pour tout autre format."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूची में न दिखने वाला एक्सटेंशन जोड़ें, फिर बाकी फ़ॉर्मेट की तरह उसके लिए ऐप चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan ekstensi yang belum ada, lalu pilih app untuknya seperti format lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧にない拡張子を追加し、ほかの形式と同じように App を選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에 없는 확장자를 추가한 다음 다른 형식처럼 앱을 선택하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma extensão que não está na lista e escolha um app para ela como em qualquer outro formato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте отсутствующее расширение и выберите для него приложение, как для любого другого формата."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มนามสกุลไฟล์ที่ไม่มีในรายการ แล้วเลือกแอปให้เหมือนรูปแบบอื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm phần mở rộng chưa có trong danh sách, rồi chọn ứng dụng cho nó như mọi định dạng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
