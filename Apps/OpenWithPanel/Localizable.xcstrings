    "GitHub didn’t respond as expected (status %lld). Try again later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب GitHub كما هو متوقع (الحالة %lld). حاول مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat nicht wie erwartet geantwortet (Status %lld). Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub no respondió como se esperaba (estado %lld). Inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub n’a pas répondu comme prévu (statut %lld). Réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ने अपेक्षित जवाब नहीं दिया (स्थिति %lld)। बाद में फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub tidak merespons seperti yang diharapkan (status %lld). Coba lagi nanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub から想定どおりの応答がありませんでした（ステータス %lld）。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 예상한 응답을 받지 못했습니다(상태 %lld). 나중에 다시 시도하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub não respondeu como esperado (status %lld). Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ответил не так, как ожидалось (статус %lld). Повторите попытку позже."
          }
        },
        "th" : {
          "stringUnit" : {
