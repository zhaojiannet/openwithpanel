    "Apply or discard your changes first, then relaunch to use the new language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طبّق تغييراتك أو تجاهلها أولًا، ثم أعد الفتح لاستخدام اللغة الجديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wende deine Änderungen zuerst an oder verwirf sie und starte dann neu, um die neue Sprache zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica o descarta primero tus cambios y luego vuelve a abrir para usar el nuevo idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez ou abandonnez d’abord vos modifications, puis relancez pour utiliser la nouvelle langue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले अपने बदलाव लागू करें या छोड़ें, फिर नई भाषा के लिए दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan atau buang perubahan Anda dulu, lalu buka ulang untuk memakai bahasa baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に変更を適用または破棄してから、再起動して新しい言語を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 변경 사항을 적용하거나 버린 다음 다시 실행하여 새 언어를 사용하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
