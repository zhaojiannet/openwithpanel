          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS はこのファイルの種類を判別できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 이 파일의 종류를 판별할 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
