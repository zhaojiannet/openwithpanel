    "No file in “%@” has its own “Open with” setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد في «%@» ملف له إعداد «فتح بواسطة» خاص به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Datei in „%@“ hat eine eigene „Öffnen mit“-Einstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún archivo de «%@» tiene su propio ajuste «Abrir con»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier de « %@ » n’a son propre réglage « Ouvrir avec »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” में किसी फ़ाइल की अपनी “इसमें खोलें” सेटिंग नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada file di “%@” yang punya pengaturan “Buka Dengan” sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」内に個別に「このアプリケーションで開く」が設定されたファイルはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 개별적으로 ‘다음으로 열기’가 설정된 파일이 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum arquivo em “%@” tem ajuste “Abrir Com” próprio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «%@» нет файлов с собственной настройкой «Открыть в приложении»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีไฟล์ใน “%@” ที่ตั้ง “เปิดด้วย” ไว้เอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có tệp nào trong “%@” có cài đặt “Mở bằng” riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”中没有单独设置了“打开方式”的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」中沒有單獨設定了「打開檔案的應用程式」的檔案。"
          }
        }
      }
    },
