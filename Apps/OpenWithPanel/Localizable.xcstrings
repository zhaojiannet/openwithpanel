    "Comma-separated type identifiers. Files of these types are sent to OpenWithPanel so this rule can see them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرّفات أنواع مفصولة بفواصل. تُرسل ملفات هذه الأنواع إلى OpenWithPanel لكي تتمكن هذه القاعدة من فحصها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Kommas getrennte Typkennungen. Dateien dieser Typen werden an OpenWithPanel übergeben, damit diese Regel sie prüfen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificadores de tipo separados por comas. Los archivos de estos tipos se envían a OpenWithPanel para que esta regla pueda verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiants de type séparés par des virgules. Les fichiers de ces types sont transmis à OpenWithPanel pour que cette règle puisse les examiner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉमा से अलग किए गए प्रकार पहचानकर्ता। इन प्रकारों की फ़ाइलें OpenWithPanel को भेजी जाती हैं ताकि यह नियम उन्हें देख सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenal jenis yang dipisahkan koma. File dengan jenis ini dikirim ke OpenWithPanel agar aturan ini dapat memeriksanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマ区切りの種類識別子。これらの種類のファイルは OpenWithPanel に渡され、このルールで判定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉼표로 구분한 유형 식별자입니다. 이 유형의 파일은 OpenWithPanel로 전달되어 이 규칙이 판단할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificadores de tipo separados por vírgula. Arquivos desses tipos são enviados ao OpenWithPanel para que esta regra possa vê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентификаторы типов через запятую. Файлы этих типов передаются в OpenWithPanel, чтобы это правило могло их проверить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวระบุประเภทคั่นด้วยจุลภาค ไฟล์ประเภทเหล่านี้จะถูกส่งให้ OpenWithPanel เพื่อให้กฎนี้ตรวจสอบได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mã định danh loại, phân tách bằng dấu phẩy. Tệp thuộc các loại này được gửi tới OpenWithPanel để quy tắc này có thể xét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用逗号分隔的类型标识符。这些类型的文件会先交给 OpenWithPanel，规则才能判断它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以逗號分隔的類型識別碼。這些類型的檔案會先交給 OpenWithPanel，規則才能判斷它們。"
          }
        }
      }
    },
