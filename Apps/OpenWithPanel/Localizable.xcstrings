        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала примените или сбросьте изменения, затем перезапустите, чтобы включить новый язык."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
