    "It follows the group’s app unless you choose one for it separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع تطبيق المجموعة ما لم تختر له تطبيقًا منفصلًا."
          }
        },
        "de" : {
          "stringUnit" : {
