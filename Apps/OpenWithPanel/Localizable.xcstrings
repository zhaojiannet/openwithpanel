    "Nothing to restore. Everything already matches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد ما يُستعاد. كل شيء متطابق بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wiederherzustellen. Alles stimmt bereits überein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que restaurar. Todo coincide ya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à restaurer. Tout correspond déjà."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहाल करने को कुछ नहीं है। सब कुछ पहले से मेल खाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang perlu dipulihkan. Semuanya sudah sesuai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元するものはありません。すでに一致しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원할 항목이 없습니다. 이미 일치합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para restaurar. Tudo já corresponde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливать нечего. Всё уже совпадает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอะไรต้องกู้คืน ทุกอย่างตรงกันแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì để khôi phục. Mọi thứ đã khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
